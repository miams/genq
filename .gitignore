.DS_Store
# ignore ALL Rootsmagic .rmtree database files
*.rmtree
*.json
.DS_Store
CLAUDE.md
Iiams.cfg
Presidents.json
docs/templates/Template_Person_Note.md
docs/development/lessons-learned.md
docs/development/beta-readiness-todo.md
vault/
# PowerShell modules dropped by Windows CI tooling
.PowershellModules/
# CI artifacts
test-report.xml
# Test database fixtures (downloaded from S3, not committed)
tests/fixtures/*.rmtree
# SQLite WAL/SHM files created when tests write to .rmtree databases
data/*.rmtree-wal
data/*.rmtree-shm
# Allow sample Presidents database
!data/pres2025.rmtree

# Terraform state and build artifacts
infra/**/.terraform/
infra/**/.terraform.lock.hcl
infra/**/terraform.tfstate
infra/**/terraform.tfstate.backup
infra/**/.build/

# Python bytecode
__pycache__/
*.pyc
