#!/bin/bash
#
# genquery-start — Launch script for GenQuery Terminal
#
# Supports two runtime modes:
#   Bundle mode: Running inside GenQuery Terminal.app (GHOSTTY_RESOURCES_DIR is set)
#   Dev mode:    Running directly from the genq repo checkout

set -e

# ---------------------------------------------------------------------------
# Resolve runtime mode
# ---------------------------------------------------------------------------

if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ] && [ -f "$GHOSTTY_RESOURCES_DIR/genq/src/main.nu" ]; then
  # --- Bundle mode ---
  BUNDLE_GENQ="$GHOSTTY_RESOURCES_DIR/genq"
  MAIN_NU="$BUNDLE_GENQ/src/main.nu"
  NU="$BUNDLE_GENQ/nu"
  GENQ_HOME="$HOME/Documents/GenQuery"

  # ---------------------------------------------------------------------------
  # First-run workspace setup
  # ---------------------------------------------------------------------------

  mkdir -p "$GENQ_HOME/data" "$GENQ_HOME/config" "$GENQ_HOME/vault" "$GENQ_HOME/sql"

  # Copy sample database if not already present
  if [ ! -f "$GENQ_HOME/data/pres2020.rmtree" ] && [ -f "$BUNDLE_GENQ/data/pres2020.rmtree" ]; then
    cp "$BUNDLE_GENQ/data/pres2020.rmtree" "$GENQ_HOME/data/pres2020.rmtree"
  fi

  # Write default genq config if not already present
  if [ ! -f "$GENQ_HOME/config/default.toml" ]; then
    cat > "$GENQ_HOME/config/default.toml" <<'TOML'
[database]
active = "demo"

[database.connections]
demo = "./data/pres2020.rmtree"

[paths]
sql_dir = "./sql"
output_dir = "./vault"

[display]
date_format = 1
table_mode = "rounded"

[extensions]
enabled = ["miams", "pres2020"]
TOML
  fi

  # Always regenerate env.nu — bundle path changes after app updates or moves
  cat > "$GENQ_HOME/config/env.nu" <<ENVNU
# Generated by genquery-start — do not edit manually
\$env.NU_LIB_DIRS = [
    "$BUNDLE_GENQ/src/lib"
    "$BUNDLE_GENQ/src/lib/ext"
]
\$env.GENQ_HOME = "$GENQ_HOME"
ENVNU

  ENV_ARGS="--env-config $GENQ_HOME/config/env.nu"

else
  # --- Dev mode ---
  # Does not touch ~/Documents/GenQuery — uses the developer's own nushell config.

  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
  MAIN_NU="$SCRIPT_DIR/../src/main.nu"

  NU=$(command -v nu 2>/dev/null \
    || { [ -x /opt/homebrew/bin/nu ] && echo /opt/homebrew/bin/nu; } \
    || { [ -x /usr/local/bin/nu ] && echo /usr/local/bin/nu; } \
    || true)

  if [ -f "$HOME/.config/nushell/env.nu" ]; then
    ENV_ARGS="--env-config $HOME/.config/nushell/env.nu"
  else
    ENV_ARGS=""
  fi
fi

# ---------------------------------------------------------------------------
# Validate
# ---------------------------------------------------------------------------

if [ -z "${NU:-}" ] || [ ! -x "$NU" ]; then
  echo "Error: nushell not found." >&2
  if [ -z "${GHOSTTY_RESOURCES_DIR:-}" ]; then
    echo "Install with: brew install nushell" >&2
  fi
  exit 1
fi

if [ ! -f "$MAIN_NU" ]; then
  echo "Error: GenQuery main.nu not found at: $MAIN_NU" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Launch
# ---------------------------------------------------------------------------

exec "$NU" --interactive $ENV_ARGS -e "source '$MAIN_NU'"
