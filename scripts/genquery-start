#!/bin/bash
#
# genquery-start — Launch script for GenQuery Terminal
#
# Supports two runtime modes:
#   Bundle mode: Running inside GenQuery Terminal.app (GHOSTTY_RESOURCES_DIR is set)
#   Dev mode:    Running directly from the genq repo checkout

set -e

# ---------------------------------------------------------------------------
# Resolve runtime mode
# ---------------------------------------------------------------------------

if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ] && [ -f "$(dirname "$GHOSTTY_RESOURCES_DIR")/genq/src/main.nu" ]; then
  # --- Bundle mode ---
  # GHOSTTY_RESOURCES_DIR points to Contents/Resources/ghostty;
  # genq files live one level up at Contents/Resources/genq.
  BUNDLE_GENQ="$(dirname "$GHOSTTY_RESOURCES_DIR")/genq"
  MAIN_NU="$BUNDLE_GENQ/src/main.nu"
  NU="$BUNDLE_GENQ/nu"
  GENQ_HOME="$HOME/Documents/GenQuery"

  # ---------------------------------------------------------------------------
  # First-run workspace setup
  # ---------------------------------------------------------------------------

  mkdir -p "$GENQ_HOME/data" "$GENQ_HOME/config" "$GENQ_HOME/vault" "$GENQ_HOME/sql"

  # Copy sample database if not already present
  if [ ! -f "$GENQ_HOME/data/pres2025.rmtree" ] && [ -f "$BUNDLE_GENQ/data/pres2025.rmtree" ]; then
    cp "$BUNDLE_GENQ/data/pres2025.rmtree" "$GENQ_HOME/data/pres2025.rmtree"
  fi

  # Always sync SQL files from bundle (they update with each release)
  if [ -d "$BUNDLE_GENQ/sql" ]; then
    cp "$BUNDLE_GENQ/sql/"*.sql "$GENQ_HOME/sql/" 2>/dev/null || true
  fi

  # Read version from bundle VERSION file
  BUNDLE_VERSION=""
  if [ -f "$BUNDLE_GENQ/VERSION" ]; then
    BUNDLE_VERSION=$(cat "$BUNDLE_GENQ/VERSION" | tr -d '[:space:]')
  fi

  # Write default genq config if not already present
  if [ ! -f "$GENQ_HOME/config/default.toml" ]; then
    cat > "$GENQ_HOME/config/default.toml" <<TOML
[metadata]
version = "${BUNDLE_VERSION}"

[database]
active = "demo"

[database.connections]
demo = "./data/pres2025.rmtree"

[paths]
sql_dir = "./sql"
output_dir = "./vault"

[display]
date_format = 1
table_mode = "rounded"

[extensions]
enabled = ["miams", "pres2025"]

[telemetry]
enabled = false
auto_send = false
endpoint_mode = "otlp"
endpoint_url = "https://n53fa2v117.execute-api.us-east-1.amazonaws.com"
retention_days = 30
TOML
  else
    # Config exists — update metadata.version to match the installed bundle
    if [ -n "$BUNDLE_VERSION" ]; then
      if grep -q '^\[metadata\]' "$GENQ_HOME/config/default.toml"; then
        # Update existing version line
        sed -i '' "s/^version = .*/version = \"${BUNDLE_VERSION}\"/" "$GENQ_HOME/config/default.toml"
      else
        # Add [metadata] section at the top
        printf '[metadata]\nversion = "%s"\n\n' "$BUNDLE_VERSION" | cat - "$GENQ_HOME/config/default.toml" > "$GENQ_HOME/config/default.toml.tmp"
        mv "$GENQ_HOME/config/default.toml.tmp" "$GENQ_HOME/config/default.toml"
      fi
    fi

    # Ensure [telemetry] section exists (added in v0.2.0+)
    if ! grep -q '^\[telemetry\]' "$GENQ_HOME/config/default.toml"; then
      cat >> "$GENQ_HOME/config/default.toml" <<'TELEMETRY'

[telemetry]
enabled = false
auto_send = false
endpoint_mode = "otlp"
endpoint_url = "https://n53fa2v117.execute-api.us-east-1.amazonaws.com"
retention_days = 30
TELEMETRY
    fi
  fi

  # Always regenerate env.nu — bundle path changes after app updates or moves
  cat > "$GENQ_HOME/config/env.nu" <<ENVNU
# Generated by genquery-start — do not edit manually
\$env.NU_LIB_DIRS = [
    "$BUNDLE_GENQ/src/lib"
    "$BUNDLE_GENQ/src/lib/ext"
]
\$env.GENQ_HOME = "$GENQ_HOME"
ENVNU

  # Suppress Nushell startup banner
  if [ ! -f "$GENQ_HOME/config/config.nu" ]; then
    cat > "$GENQ_HOME/config/config.nu" <<'CONFIGNU'
# Generated by genquery-start
$env.config.show_banner = false
CONFIGNU
  fi

  ENV_ARGS="--env-config $GENQ_HOME/config/env.nu --config $GENQ_HOME/config/config.nu"
  cd "$GENQ_HOME"

else
  # --- Dev mode ---
  # Does not touch ~/Documents/GenQuery — uses the developer's own nushell config.

  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
  MAIN_NU="$SCRIPT_DIR/../src/main.nu"

  NU=$(command -v nu 2>/dev/null \
    || { [ -x /opt/homebrew/bin/nu ] && echo /opt/homebrew/bin/nu; } \
    || { [ -x /usr/local/bin/nu ] && echo /usr/local/bin/nu; } \
    || true)

  if [ -f "$HOME/.config/nushell/env.nu" ]; then
    ENV_ARGS="--env-config $HOME/.config/nushell/env.nu"
  else
    ENV_ARGS=""
  fi
fi

# ---------------------------------------------------------------------------
# Validate
# ---------------------------------------------------------------------------

if [ -z "${NU:-}" ] || [ ! -x "$NU" ]; then
  echo "Error: nushell not found." >&2
  if [ -z "${GHOSTTY_RESOURCES_DIR:-}" ]; then
    echo "Install with: brew install nushell" >&2
  fi
  exit 1
fi

if [ ! -f "$MAIN_NU" ]; then
  echo "Error: GenQuery main.nu not found at: $MAIN_NU" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Launch
# ---------------------------------------------------------------------------

exec "$NU" --interactive $ENV_ARGS -e "source '$MAIN_NU'; genq"
